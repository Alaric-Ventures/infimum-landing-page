# -----------------------------------------------------------------------------
# Public site URL
# Used for canonical URLs, sitemap.xml, robots.txt, Open Graph and JSON-LD.
# Do not include a trailing slash.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://10.20.30.91:6003
# -----------------------------------------------------------------------------
# Contact form email delivery (Resend — https://resend.com)
#
# The form will return a clear "not configured" error until all three values
# below are set. It never simulates a successful submission.
#
# 1. Create a Resend account and API key.
# 2. Verify the sending domain in Resend.
# 3. Use an address on that verified domain in CONTACT_FROM_EMAIL.
# 4. Set CONTACT_TO_EMAIL to the inbox that should receive enquiries.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

CONTACT_TO_EMAIL=

# Example: Infimum Consulting <enquiries@infimumconsulting.com.au>
CONTACT_FROM_EMAIL=
